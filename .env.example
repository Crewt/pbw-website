# PBW backend configuration — copy this file to ".env" and fill in real values.
# (.env is read at startup via dotenv; never commit it.)

# HTTP
PORT=3042
# Runtime mode. Set to "production" on real servers. Anything other than
# "development" is treated as a hardened deployment: Secure cookies default ON
# and a missing/short SESSION_SECRET aborts startup (see below).
NODE_ENV=production
# Secure flag on the admin session cookie.
#  - unset: defaults ON unless NODE_ENV=development (safe default for prod).
#  - "true"/"false": explicit override (wins over the NODE_ENV default).
# Use "false" only for local HTTP development where you have no TLS.
COOKIE_SECURE=true
# Reverse-proxy hop count for X-Forwarded-For / req.ip. Keep "1" behind a single
# Nginx/pm2 proxy that OVERWRITES X-Forwarded-For. Only change this if you know
# your proxy topology; a wrong value lets clients spoof their IP. Accepts a
# number, "true"/"false", or a subnet string.
TRUST_PROXY=1
# Public origin for canonical/OG URLs, sitemap.xml and llms.txt (no trailing slash).
# Production is https://pbw-ta.de; set your dev URL here on the dev server.
SITE_URL=https://pbw-ta.de
# Set to "true" on staging/dev mirrors (e.g. pbw.barhelper.de) to send
# X-Robots-Tag: noindex on every response so the mirror is not indexed.
SEO_NOINDEX=false

# MariaDB / MySQL connection (the app logs in as PBWUser — see db/schema.sql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pbw
DB_USER=PBWUser
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# Secret used to sign admin session cookies (HMAC-SHA256). REQUIRED in production
# and must be at least 32 characters — the server refuses to start otherwise.
# Generate a strong value and paste it here:
#   openssl rand -hex 32
SESSION_SECRET=


# SMTP-Versand für Kontaktformular-Benachrichtigungen
SMTP_HOST=mail.your-server.de
SMTP_PORT=587
SMTP_USER=<Here_should_be_your_Stuff>
SMTP_PASS=<Here_should_be_your_Stuff>
# Absenderadresse (muss zum SMTP-Konto passen)
SMTP_FROM=<Here_should_be_your_Stuff>
# Empfänger der Benachrichtigung. Leer lassen = an SMTP_FROM senden.
CONTACT_TO=

# Erlaubte Origins für Browser-Requests an /api (kommagetrennt).
# Staging läuft über pbw.barhelper.de, Produktion über pbw-ta.de.
ALLOWED_ORIGINS=https://pbw-ta.de,https://pbw.barhelper.de