# PBW backend configuration — copy this file to ".env" and fill in real values.
# (.env is read at startup via dotenv; never commit it.)

# HTTP
PORT=3042
# Set to "true" only when served over HTTPS (adds Secure flag to the admin cookie)
COOKIE_SECURE=false
# Public origin for canonical/OG URLs, sitemap.xml and llms.txt (no trailing slash).
# Production is https://pbw-ta.de; set your dev URL here on the dev server.
SITE_URL=https://pbw-ta.de
# Set to "true" on staging/dev mirrors (e.g. pbw.barhelper.de) to send
# X-Robots-Tag: noindex on every response so the mirror is not indexed.
SEO_NOINDEX=false

# MariaDB / MySQL connection (the app logs in as PBWUser — see db/schema.sql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pbw
DB_USER=PBWUser
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# Secret used to sign admin session cookies (HMAC-SHA256).
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_RANDOM_64_HEX


# SMTP-Versand für Kontaktformular-Benachrichtigungen
SMTP_HOST=mail.your-server.de
SMTP_PORT=587
SMTP_USER=<Here_should_be_your_Stuff>
SMTP_PASS=<Here_should_be_your_Stuff>
# Absenderadresse (muss zum SMTP-Konto passen)
SMTP_FROM=<Here_should_be_your_Stuff>
# Empfänger der Benachrichtigung. Leer lassen = an SMTP_FROM senden.
CONTACT_TO=

# Erlaubte Origins für Browser-Requests an /api (kommagetrennt).
# Staging läuft über pbw.barhelper.de, Produktion über pbw-ta.de.
ALLOWED_ORIGINS=https://pbw-ta.de,https://pbw.barhelper.de