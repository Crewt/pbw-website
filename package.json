{
  "name": "pbw-website",
  "version": "1.0.0",
  "description": "PBW Website",
  "main": "dist/server.js",
  "scripts": {
    "build:ts": "tsc",
    "build:css": "npx tailwindcss -i ./src/styles/input.css -o ./public/styles.css --minify",
    "build": "npm run build:ts && npm run build:css",
    "dev": "concurrently \"tsc --watch\" \"npx tailwindcss -i ./src/styles/input.css -o ./public/styles.css --watch\" \"nodemon dist/server.js\"",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "nodemon": "^3.1.4",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3"
  }
}
