{
  "name": "pbw-website",
  "version": "1.0.0",
  "description": "PBW Website",
  "main": "dist/server.js",
  "scripts": {
    "build:ts": "tsc",
    "build": "test \"$(id -u)\" != 0 || exec sudo -u pbw -H npm run build; npm run build:ts && npm run build:web",
    "dev": "concurrently \"tsc --watch\" \"nodemon dist/server.js\"",
    "dev:web": "npm --prefix frontend run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:web\"",
    "build:web": "npm --prefix frontend run build",
    "start": "node dist/server.js",
    "seed": "node dist/scripts/seed.js",
    "admin:create": "node dist/scripts/create-admin.js",
    "favicons": "node scripts/gen-favicons.mjs",
    "deploy": "test \"$(id -u)\" != 0 || exec sudo -u pbw -H npm run deploy; npm i && npm run build && pm2 restart pbw-website --update-env"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.22.5",
    "nodemailer": "^9.0.3",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "concurrently": "^9.0.0",
    "nodemon": "^3.1.4",
    "png-to-ico": "^3.0.1",
    "typescript": "^5.5.3"
  }
}
